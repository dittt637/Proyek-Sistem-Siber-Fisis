# ====== EDIT FILE INI SAJA ======
# Alamat broker MQTT milik Adit (ganti 192.168.x.x dengan IP laptop/server Adit)
MQTT_URL=mqtt://192.168.1.10:1883
# Alamat WebSocket broker yang sama, dipakai dashboard di browser (port WebSocket biasanya 9001)
MQTT_WS_URL=ws://192.168.1.10:9001
# Isi hanya jika broker Adit memakai username/password, kalau tidak biarkan kosong
MQTT_USER=
MQTT_PASS=
# Opsional
PORT=3000
